[Desktop Entry]
Type=Application
Name=Sinribe
GenericName=Audio Transcription
Comment=Offline transcription with speaker labels
# install.sh rewrites Exec to the absolute path of sinribe-run.
Exec=sinribe-run
Icon=audio-input-microphone
Terminal=false
Categories=AudioVideo;Audio;
Keywords=transcribe;transcription;speech;whisper;diarization;subtitles;
StartupNotify=true
StartupWMClass=sinribe
